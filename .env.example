# ---- LLM ----
LLM_PROVIDER=ollama              # openai | anthropic | groq | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                 # set to a current model name from Anthropic docs

# ---- Groq ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENCY=1         # parallelism for map-reduce on local models

# ---- Embeddings ----
EMBEDDING_PROVIDER=ollama        # openai | ollama
OPENAI_EMBED_MODEL=text-embedding-3-small
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Retrieval / chunking ----
CHROMA_PERSIST_DIR=./data/vectorstore
CACHE_DIR=./data/cache
RETRIEVAL_TOP_K=6
RETRIEVAL_FETCH_K=20
CHUNK_SIZE=1500
CHUNK_OVERLAP=225

# ---- Limits ----
MAX_UPLOAD_MB=25
MAX_PAGES=60
MAX_SLIDES=15
MIN_SLIDES=8

# ---- App ----
APP_PORT=8501
LOG_LEVEL=INFO
